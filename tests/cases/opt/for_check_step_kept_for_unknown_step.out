=== IR before optimization ===
    INPUT s
    t1 = s
    i = 1
    CHECK_STEP t1
L1:
    t3 = t1 > 0
    IF_FALSE t3 GOTO L3
    t2 = i <= 3
    GOTO L4
L3:
    t2 = i >= 3
L4:
    IF_FALSE t2 GOTO L2
    PRINTN i
    t4 = i + t1
    t5 = t4 < i
    t7 = t1 < 0
    t6 = t5 != t7
    IF_TRUE t6 GOTO L2
    i = t4
    GOTO L1
L2:

=== IR after optimization ===
    INPUT s
    t1 = s
    i = 1
